#!/bin/sh
# pre-commit — run the confidentiality/credential scanner over the staged changes.
#
# ACTIVATION (per clone, once):
#     git config core.hooksPath .githooks
#
# This hook is PUBLIC. The patterns it enforces do not have to be:
#
#     export CONFIDENTIALITY_DENYLIST_FILE="$HOME/.config/compass/denylist.txt"
#
# points the scanner at an operator-owned pattern file that lives OUTSIDE the
# repo — one regex per line, `#` comments ignored. The guard is shared through
# this file; each operator's sensitive strings never enter the repository. With
# the variable unset, only the built-in generic credential rules run.
#
# The scanner reports `file:line: rule-name` and never prints matched content
# (sops/confidentiality-gate.md §0, the never-quote rule). Open the locations it
# names; do not paste what you find into a commit message, a PR, or a chat.
#
# WHY THIS VARIABLE ENDS IN _FILE
# --------------------------------
# It used to be called CONFIDENTIALITY_DENYLIST — the same name
# sops/confidentiality-gate.md (§0, §2) gives an org CI secret carrying the
# HASHED denylist payload, read by a gate engine that also holds a separate
# pepper secret. This repo ships none of that machinery. leak-check implements
# only the SOP's PLAINTEXT "local gate" capability: it wants a FILE PATH to a
# file of plaintext regexes, one per line.
#
# Two different contracts under one name is not a documentation problem, it is a
# fail-open. Point the old shared name at a SOP-shaped hashed payload and the
# scanner said "pattern file not found", warned, and exited 0 — green on exactly
# the terms you meant to guard. The rename has now HAPPENED: the SOP keeps
# CONFIDENTIALITY_DENYLIST for its hashed payload, and the path this scanner
# reads is CONFIDENTIALITY_DENYLIST_FILE. A name that lies is worse than a long
# name, and the _FILE suffix says what the value is.
#
# --require-patterns still turns a missing or unreadable pattern file into a hard
# error. Local hook use deliberately stays warn-and-continue (see FAIL-OPEN
# below); CI defaults to --require-patterns instead.
#
# WHERE THE SCANNER COMES FROM
# -----------------------------
# Two resolutions, tried in order:
#
#   1. $repo_root/.githooks/leak-check.ts — an INSTALLED target. The compass-core
#      installer's --with-ci arm copies the scanner in beside this hook, so the
#      gate travels as one self-contained pair.
#   2. $repo_root/engine/validators/leak-check.ts — compass-core itself, and any
#      repo that vendors the engine wholesale.
#
# Copying is safe because leak-check.ts imports node builtins only (node:util,
# node:fs, node:path): no package, no relative import, no dependency on the tree
# it was copied out of. It runs anywhere bun does.
#
# This hook once shipped WITHOUT arm 1, while the installer copied the hook and
# the workflow but never engine/. Every installed target therefore resolved a
# path that does not exist there, took the "scanner not found" arm below, and
# exited 0 on every commit — a gate that looked armed and had never scanned a
# byte. Arm 1 is what makes that arm unreachable in a --with-ci install, and a
# test asserts exactly that (engine/__tests__/install.test.ts).
#
# FAIL-OPEN, DELIBERATELY
# -----------------------
# Missing tooling (no bun, no scanner) prints how to fix it and exits 0 — the
# commit proceeds. This is a considered trade, not an oversight: a hook that
# bricks every commit for a reason unrelated to the commit gets deleted, and a
# deleted hook protects nothing. Fail-open on TOOLING, fail-closed on FINDINGS —
# once the scanner runs, its exit code is this hook's exit code, and no
# `--no-verify` habit is condoned by that. The authoritative gate is CI, which
# controls its own runtime and does not degrade.
#
# Note what fail-open must never become: the arm everybody always takes. It is a
# concession to the operator whose bun is missing, not the resting state.

# Note: no `set -e` — this hook inspects the scanner's exit code deliberately.
set -u

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "pre-commit: not inside a git repository — skipping leak-check." >&2
  exit 0
}

# Installed copy first, engine checkout second. See WHERE THE SCANNER COMES FROM.
scanner_installed="$repo_root/.githooks/leak-check.ts"
scanner_engine="$repo_root/engine/validators/leak-check.ts"

if [ -f "$scanner_installed" ]; then
  scanner="$scanner_installed"
else
  scanner="$scanner_engine"
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found — leak-check SKIPPED, commit allowed." >&2
  echo "            Install it (https://bun.sh) to re-arm this hook:" >&2
  echo "              curl -fsSL https://bun.sh/install | bash" >&2
  exit 0
fi

if [ ! -f "$scanner" ]; then
  echo "pre-commit: no leak-check scanner found — leak-check SKIPPED, commit allowed." >&2
  echo "            Looked for, in order:" >&2
  echo "              $scanner_installed" >&2
  echo "              $scanner_engine" >&2
  echo "            A compass-core install with --with-ci writes the first of those" >&2
  echo "            alongside this hook. Re-run the installer to re-arm the gate:" >&2
  echo "              bun <compass-core>/engine/install.ts $repo_root --with-ci" >&2
  exit 0
fi

# CONFIDENTIALITY_DENYLIST_FILE is read from the environment by the scanner itself.
if bun "$scanner" --staged; then
  status=0
else
  status=$?
fi

if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: leak-check failed (exit $status) — commit blocked." >&2
  echo "            Fix the flagged locations. If a finding is genuinely public and inert," >&2
  echo "            resolve it in the source or the pattern file, not with --no-verify." >&2
fi

exit "$status"
